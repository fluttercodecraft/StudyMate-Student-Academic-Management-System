        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% =========================\n%% ENTITIES\n%% =========================\n\nSTUDENT[STUDENT]\nTEACHER[TEACHER]\nADMIN[ADMIN]\nCOURSE[COURSE]\nMATERIAL[MATERIAL]\nASSIGNMENT[ASSIGNMENT]\nSUBMISSION[SUBMISSION]\nQUIZ[QUIZ]\nQUESTION[QUESTION]\nATTENDANCE[ATTENDANCE]\nTIMETABLE[TIMETABLE]\nMARKS[MARKS]\nGPA[GPA]\nNOTIFICATION[NOTIFICATION]\n\n\n%% =========================\n%% ATTRIBUTES - OVALS\n%% =========================\n\nS_ID([\&quot;Student_ID PK\&quot;])\nS_NAME([\&quot;Name\&quot;])\nS_EMAIL([\&quot;Email\&quot;])\nS_DEPT([\&quot;Department\&quot;])\nS_SEM([\&quot;Semester\&quot;])\n\nT_ID([\&quot;Teacher_ID PK\&quot;])\nT_NAME([\&quot;Name\&quot;])\nT_EMAIL([\&quot;Email\&quot;])\n\nAD_ID([\&quot;Admin_ID PK\&quot;])\nAD_NAME([\&quot;Name\&quot;])\nAD_EMAIL([\&quot;Email\&quot;])\n\nC_ID([\&quot;Course_ID PK\&quot;])\nC_NAME([\&quot;Course_Name\&quot;])\nC_CODE([\&quot;Course_Code\&quot;])\nC_HOURS([\&quot;Credit_Hours\&quot;])\n\nM_ID([\&quot;Material_ID PK\&quot;])\nM_TITLE([\&quot;Title\&quot;])\nM_URL([\&quot;File_URL\&quot;])\nM_DATE([\&quot;Upload_Date\&quot;])\n\nA_ID([\&quot;Assignment_ID PK\&quot;])\nA_TITLE([\&quot;Title\&quot;])\nA_DESC([\&quot;Description\&quot;])\nA_DUE([\&quot;Due_Date\&quot;])\n\nSU_ID([\&quot;Submission_ID PK\&quot;])\nSU_DATE([\&quot;Submission_Date\&quot;])\nSU_FILE([\&quot;File_URL\&quot;])\nSU_MARKS([\&quot;Marks\&quot;])\n\nQ_ID([\&quot;Quiz_ID PK\&quot;])\nQ_TITLE([\&quot;Title\&quot;])\nQ_DATE([\&quot;Quiz_Date\&quot;])\n\nQU_ID([\&quot;Question_ID PK\&quot;])\nQU_TEXT([\&quot;Question_Text\&quot;])\nQU_ANS([\&quot;Correct_Answer\&quot;])\n\nAT_ID([\&quot;Attendance_ID PK\&quot;])\nAT_DATE([\&quot;Date\&quot;])\nAT_STATUS([\&quot;Status\&quot;])\n\nTT_ID([\&quot;Timetable_ID PK\&quot;])\nTT_DAY([\&quot;Day\&quot;])\nTT_START([\&quot;Start_Time\&quot;])\nTT_END([\&quot;End_Time\&quot;])\nTT_ROOM([\&quot;Room\&quot;])\n\nMK_ID([\&quot;Mark_ID PK\&quot;])\nMK_MARKS([\&quot;Marks\&quot;])\nMK_GRADE([\&quot;Grade\&quot;])\n\nGPA_ID([\&quot;GPA_ID PK\&quot;])\nGPA_SEM([\&quot;Semester\&quot;])\nGPA_VALUE([\&quot;GPA_Value\&quot;])\n\nN_ID([\&quot;Notification_ID PK\&quot;])\nN_TITLE([\&quot;Title\&quot;])\nN_MESSAGE([\&quot;Message\&quot;])\nN_DATE([\&quot;Date\&quot;])\nN_STATUS([\&quot;Status\&quot;])\n\n\n%% =========================\n%% ENTITY - ATTRIBUTE\n%% =========================\n\nSTUDENT --- S_ID\nSTUDENT --- S_NAME\nSTUDENT --- S_EMAIL\nSTUDENT --- S_DEPT\nSTUDENT --- S_SEM\n\nTEACHER --- T_ID\nTEACHER --- T_NAME\nTEACHER --- T_EMAIL\n\nADMIN --- AD_ID\nADMIN --- AD_NAME\nADMIN --- AD_EMAIL\n\nCOURSE --- C_ID\nCOURSE --- C_NAME\nCOURSE --- C_CODE\nCOURSE --- C_HOURS\n\nMATERIAL --- M_ID\nMATERIAL --- M_TITLE\nMATERIAL --- M_URL\nMATERIAL --- M_DATE\n\nASSIGNMENT --- A_ID\nASSIGNMENT --- A_TITLE\nASSIGNMENT --- A_DESC\nASSIGNMENT --- A_DUE\n\nSUBMISSION --- SU_ID\nSUBMISSION --- SU_DATE\nSUBMISSION --- SU_FILE\nSUBMISSION --- SU_MARKS\n\nQUIZ --- Q_ID\nQUIZ --- Q_TITLE\nQUIZ --- Q_DATE\n\nQUESTION --- QU_ID\nQUESTION --- QU_TEXT\nQUESTION --- QU_ANS\n\nATTENDANCE --- AT_ID\nATTENDANCE --- AT_DATE\nATTENDANCE --- AT_STATUS\n\nTIMETABLE --- TT_ID\nTIMETABLE --- TT_DAY\nTIMETABLE --- TT_START\nTIMETABLE --- TT_END\nTIMETABLE --- TT_ROOM\n\nMARKS --- MK_ID\nMARKS --- MK_MARKS\nMARKS --- MK_GRADE\n\nGPA --- GPA_ID\nGPA --- GPA_SEM\nGPA --- GPA_VALUE\n\nNOTIFICATION --- N_ID\nNOTIFICATION --- N_TITLE\nNOTIFICATION --- N_MESSAGE\nNOTIFICATION --- N_DATE\nNOTIFICATION --- N_STATUS\n\n\n%% =========================\n%% RELATIONSHIP DIAMONDS\n%% =========================\n\nENROLLS{ENROLLS}\nTEACHES{TEACHES}\nUPLOADS_MATERIAL{UPLOADS}\nCOURSE_UPLOADS{UPLOADS}\nHAS_ASSIGNMENT{HAS}\nSUBMITS_STUDENT{SUBMITS}\nSUBMITS_ASSIGNMENT{SUBMITS}\nHAS_QUIZ{HAS}\nCONTAINS{CONTAINS}\nATTENDS_STUDENT{ATTENDS}\nATTENDS_COURSE{ATTENDS}\nSCHEDULED_COURSE{SCHEDULED}\nSCHEDULED_TEACHER{SCHEDULED}\nRECEIVES_MARKS{RECEIVES}\nHAS_MARKS{HAS}\nHAS_GPA{HAS}\nRECEIVES_NOTIFICATION{RECEIVES}\nMANAGES{MANAGES}\n\n\n%% =========================\n%% ENTITY - RELATIONSHIP\n%% =========================\n\nSTUDENT ---|M| ENROLLS\nENROLLS ---|N| COURSE\n\nTEACHER ---|1| TEACHES\nTEACHES ---|N| COURSE\n\nTEACHER ---|1| UPLOADS_MATERIAL\nUPLOADS_MATERIAL ---|N| MATERIAL\n\nCOURSE ---|1| COURSE_UPLOADS\nCOURSE_UPLOADS ---|N| MATERIAL\n\nCOURSE ---|1| HAS_ASSIGNMENT\nHAS_ASSIGNMENT ---|N| ASSIGNMENT\n\nSTUDENT ---|1| SUBMITS_STUDENT\nSUBMITS_STUDENT ---|N| SUBMISSION\n\nASSIGNMENT ---|1| SUBMITS_ASSIGNMENT\nSUBMITS_ASSIGNMENT ---|N| SUBMISSION\n\nCOURSE ---|1| HAS_QUIZ\nHAS_QUIZ ---|N| QUIZ\n\nQUIZ ---|1| CONTAINS\nCONTAINS ---|N| QUESTION\n\nSTUDENT ---|1| ATTENDS_STUDENT\nATTENDS_STUDENT ---|N| ATTENDANCE\n\nCOURSE ---|1| ATTENDS_COURSE\nATTENDS_COURSE ---|N| ATTENDANCE\n\nCOURSE ---|1| SCHEDULED_COURSE\nSCHEDULED_COURSE ---|N| TIMETABLE\n\nTEACHER ---|1| SCHEDULED_TEACHER\nSCHEDULED_TEACHER ---|N| TIMETABLE\n\nSTUDENT ---|1| RECEIVES_MARKS\nRECEIVES_MARKS ---|N| MARKS\n\nCOURSE ---|1| HAS_MARKS\nHAS_MARKS ---|N| MARKS\n\nSTUDENT ---|1| HAS_GPA\nHAS_GPA ---|N| GPA\n\nSTUDENT ---|1| RECEIVES_NOTIFICATION\nRECEIVES_NOTIFICATION ---|N| NOTIFICATION\n\nADMIN ---|1| MANAGES\nMANAGES ---|N| COURSE\n\n\n%% =========================\n%% STYLING\n%% =========================\n\nclassDef entity fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000\nclassDef attribute fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000\nclassDef relationship fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000\n\nclass STUDENT,TEACHER,ADMIN,COURSE,MATERIAL,ASSIGNMENT,SUBMISSION,QUIZ,QUESTION,ATTENDANCE,TIMETABLE,MARKS,GPA,NOTIFICATION entity\n\nclass S_ID,S_NAME,S_EMAIL,S_DEPT,S_SEM,T_ID,T_NAME,T_EMAIL,AD_ID,AD_NAME,AD_EMAIL,C_ID,C_NAME,C_CODE,C_HOURS,M_ID,M_TITLE,M_URL,M_DATE,A_ID,A_TITLE,A_DESC,A_DUE,SU_ID,SU_DATE,SU_FILE,SU_MARKS,Q_ID,Q_TITLE,Q_DATE,QU_ID,QU_TEXT,QU_ANS,AT_ID,AT_DATE,AT_STATUS,TT_ID,TT_DAY,TT_START,TT_END,TT_ROOM,MK_ID,MK_MARKS,MK_GRADE,GPA_ID,GPA_SEM,GPA_VALUE,N_ID,N_TITLE,N_MESSAGE,N_DATE,N_STATUS attribute\n\nclass ENROLLS,TEACHES,UPLOADS_MATERIAL,COURSE_UPLOADS,HAS_ASSIGNMENT,SUBMITS_STUDENT,SUBMITS_ASSIGNMENT,HAS_QUIZ,CONTAINS,ATTENDS_STUDENT,ATTENDS_COURSE,SCHEDULED_COURSE,SCHEDULED_TEACHER,RECEIVES_MARKS,HAS_MARKS,HAS_GPA,RECEIVES_NOTIFICATION,MANAGES relationship&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="21qQXIADaiNQS-uw6SI_-1073">
