      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle StudyMate - Student Learning and Academic Management System\nleft to right direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\nskinparam actorStyle stickman\n\nskinparam usecase {\n    BackgroundColor white\n    BorderColor black\n    FontColor black\n}\n\n&#39; =========================================================\n&#39; ACTORS\n&#39; =========================================================\n\nactor Student\nactor Teacher\nactor Admin\n\n\n&#39; =========================================================\n&#39; STUDYMATE SYSTEM BOUNDARY\n&#39; =========================================================\n\nrectangle \&quot;StudyMate System\&quot; {\n\n    &#39; =====================================================\n    &#39; AUTHENTICATION &amp; PROFILE\n    &#39; =====================================================\n\n    usecase \&quot;Register Account\&quot; as FR01\n    usecase \&quot;Login\&quot; as FR02\n    usecase \&quot;Manage Profile\&quot; as FR04\n\n\n    &#39; =====================================================\n    &#39; COURSE MANAGEMENT\n    &#39; =====================================================\n\n    usecase \&quot;View Courses\&quot; as FR05\n    usecase \&quot;Manage Courses\&quot; as FR06\n\n\n    &#39; =====================================================\n    &#39; STUDY MATERIALS\n    &#39; =====================================================\n\n    usecase \&quot;Upload Study Materials\&quot; as FR07\n    usecase \&quot;Access Study Materials\&quot; as FR08\n\n\n    &#39; =====================================================\n    &#39; ASSIGNMENTS\n    &#39; =====================================================\n\n    usecase \&quot;Create Assignment\&quot; as FR09\n    usecase \&quot;Submit Assignment\&quot; as FR10\n    usecase \&quot;Check Assignment Status\&quot; as FR11\n\n\n    &#39; =====================================================\n    &#39; QUIZZES\n    &#39; =====================================================\n\n    usecase \&quot;Create / Manage Quiz\&quot; as FR12\n    usecase \&quot;Attempt Quiz\&quot; as FR13\n    usecase \&quot;View Quiz Result\&quot; as FR14\n\n\n    &#39; =====================================================\n    &#39; ATTENDANCE\n    &#39; =====================================================\n\n    usecase \&quot;Record Attendance\&quot; as FR15\n    usecase \&quot;View Attendance\&quot; as FR16\n\n\n    &#39; =====================================================\n    &#39; TIMETABLE\n    &#39; =====================================================\n\n    usecase \&quot;View Timetable\&quot; as FR17\n\n\n    &#39; =====================================================\n    &#39; MARKS &amp; PROGRESS\n    &#39; =====================================================\n\n    usecase \&quot;Manage Marks\&quot; as FR18\n    usecase \&quot;View Marks\&quot; as FR19\n    usecase \&quot;View GPA &amp; Academic Progress\&quot; as FR20\n    usecase \&quot;View Student Progress\&quot; as FR22\n\n\n    &#39; =====================================================\n    &#39; NOTIFICATIONS\n    &#39; =====================================================\n\n    usecase \&quot;Receive Notifications\&quot; as FR21\n\n\n    &#39; =====================================================\n    &#39; ADMIN MANAGEMENT\n    &#39; =====================================================\n\n    usecase \&quot;Manage Users\&quot; as FR23\n    usecase \&quot;Manage Departments\&quot; as FR24\n\n\n    &#39; =====================================================\n    &#39; SEARCH\n    &#39; =====================================================\n\n    usecase \&quot;Search Academic Information\&quot; as FR25\n\n\n    &#39; =====================================================\n    &#39; FR-03 ROLE-BASED ACCESS\n    &#39; =====================================================\n\n    note right of FR02\n      FR-03: Role-Based Access\n\n      The system provides different\n      functionality according to the\n      authenticated user&#39;s role:\n      Student, Teacher, or Admin.\n\n      This is a security/authorization\n      constraint rather than an\n      independent user goal.\n    end note\n}\n\n\n&#39; =========================================================\n&#39; STUDENT ASSOCIATIONS\n&#39; =========================================================\n\nStudent -- FR01\nStudent -- FR02\nStudent -- FR04\nStudent -- FR05\nStudent -- FR08\nStudent -- FR10\nStudent -- FR11\nStudent -- FR13\nStudent -- FR14\nStudent -- FR16\nStudent -- FR17\nStudent -- FR19\nStudent -- FR20\nStudent -- FR21\nStudent -- FR25\n\n\n&#39; =========================================================\n&#39; TEACHER ASSOCIATIONS\n&#39; =========================================================\n\nTeacher -- FR02\nTeacher -- FR04\nTeacher -- FR05\nTeacher -- FR06\nTeacher -- FR07\nTeacher -- FR09\nTeacher -- FR12\nTeacher -- FR15\nTeacher -- FR17\nTeacher -- FR18\nTeacher -- FR22\nTeacher -- FR21\nTeacher -- FR25\n\n\n&#39; =========================================================\n&#39; ADMIN ASSOCIATIONS\n&#39; =========================================================\n\nAdmin -- FR02\nAdmin -- FR04\nAdmin -- FR06\nAdmin -- FR23\nAdmin -- FR24\nAdmin -- FR21\nAdmin -- FR25\n\n\n&#39; =========================================================\n&#39; LAYOUT CONTROL\n&#39; Hidden relationships only control visual arrangement.\n&#39; They are NOT UML functional relationships.\n&#39; =========================================================\n\nFR01 -[hidden]down- FR02\nFR02 -[hidden]down- FR04\nFR04 -[hidden]down- FR21\nFR21 -[hidden]down- FR25\n\nFR05 -[hidden]down- FR08\nFR08 -[hidden]down- FR10\nFR10 -[hidden]down- FR11\nFR11 -[hidden]down- FR13\nFR13 -[hidden]down- FR14\nFR14 -[hidden]down- FR16\nFR16 -[hidden]down- FR17\nFR17 -[hidden]down- FR19\nFR19 -[hidden]down- FR20\n\nFR06 -[hidden]down- FR07\nFR07 -[hidden]down- FR09\nFR09 -[hidden]down- FR12\nFR12 -[hidden]down- FR15\nFR15 -[hidden]down- FR18\nFR18 -[hidden]down- FR22\n\nFR23 -[hidden]down- FR24\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QXUzEnBc7qT9wd21oeHS-1">
